APP_NAME="Face Registry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local: SQLite (database/database.sqlite). Production: pgsql + DB_URL (Neon).
DB_CONNECTION=sqlite
# DB_URL=postgresql://user:password@ep-xxx-123.region.aws.neon.tech/neondb?sslmode=require
# Neon only, where libpq lacks SNI (vercel-php): the first part of the DB_URL host.
# PGOPTIONS=endpoint=ep-xxx-123

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Only behind a proxy that overwrites X-Forwarded-* (Vercel sets "*" in vercel.json).
# Leave empty when the app is reached directly, or clients can fake their IP.
TRUSTED_PROXIES=

# Face registry (config/face.php). The first four are required.
# FACE_MATCH_THRESHOLD is provisional [ASUMSI]: calibrate it (T-034).
FACE_MATCH_THRESHOLD=0.9
FACE_EMBEDDING_DIM=1024
FACE_MODEL_VERSION=human-3.3.6-faceres
FACE_MODEL_URL=https://cdn.jsdelivr.net/npm/@vladmandic/human@3.3.6/models/
FACE_CONSENT_VERSION=1.0
FACE_MAX_TEMPLATES=2000
# Glasses check on the nose bridge (F-17), 0 = off. [ASUMSI] calibrate on real devices.
FACE_GLASSES_MAX_EDGE=12
# Local calibration only: logs the best similarity per match.
FACE_LOG_SIMILARITY=false
